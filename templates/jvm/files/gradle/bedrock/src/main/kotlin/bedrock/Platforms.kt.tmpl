package bedrock

import org.gradle.api.Project

/**
 * The platforms a module builds: the comma-separated bedrock.platforms property, which `bedrock init
 * <kind>@<platforms>` writes to the module's gradle.properties, or [default] when it names none.
 */
internal fun Project.platforms(default: Set<String>): Set<String> =
  (findProperty("bedrock.platforms") as String?)
    ?.split(',')
    ?.map(String::trim)
    ?.filter(String::isNotEmpty)
    ?.toSet() ?: default
