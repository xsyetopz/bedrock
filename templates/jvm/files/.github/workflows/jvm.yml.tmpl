# Managed by bedrock.
name: JVM

on:
  push:
    branches: [main, master]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  jvm:
    # The runner's Temurin 25, its default JDK, starts Gradle and runs the daemon, which Gradle
    # finds in /usr/lib/jvm without a download. Gradle fetches GraalVM Community for the compilers,
    # and the runner's Android SDK builds the Android targets.
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: gradle/actions/setup-gradle@8da46b539cd8fe6ab27ca75128919a18d757604c # v6.4.1
      # uv runs the pinned lizard that bedrock guard bounds sizes with.
      - uses: taiki-e/install-action@ab49d3c64680143e184118bed66a46419fc15519 # v2.90.5
        with:
          tool: just@1.59.0,uv@0.13.7
      - run: just jvm::verify
