import { afterAll, expect, test } from "bun:test";

import { start } from "./app.ts";

const server = start(0);

afterAll(async () => {
	await server.stop(true);
});

test("the health route reports ok", async () => {
	const response = await fetch(new URL("/api/health", server.url));

	expect(await response.json()).toEqual({ status: "ok" });
});

test("a route reads its path parameter", async () => {
	const response = await fetch(new URL("/api/hello/Ada", server.url));

	expect(await response.json()).toEqual({ message: "Hello, Ada!" });
});

test("an unknown path is not found", async () => {
	const response = await fetch(new URL("/missing", server.url));

	expect(response.status).toBe(404);
});
