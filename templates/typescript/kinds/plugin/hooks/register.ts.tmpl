import type { Engine, Hook, On } from "./engine.ts";

// The hook loader follows the engine `$` only into a function declaration, so a helper that takes `$` is one.
/** Registers the plugin's slash command. */
export function registerHello($: Engine): Promise<unknown> {
	return $.command.register({
		name: "hello",
		description: `Say hello from ${$.plugin.name}.`
	});
}

/** Registers the slash commands, then continues. */
export const announce: Hook<unknown> = async ($, e, next) => {
	await registerHello($);
	return next(e);
};

/** Wires each hook to its event. */
export const register = (on: On): void => {
	on("session.start", announce);
};
