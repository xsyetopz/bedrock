{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "include": [
    @@presetIncludes@@
  ],
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Host",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
