{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "maccatalyst",
      "displayName": "Mac Catalyst (arm64)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_C_COMPILER_TARGET": "arm64-apple-ios15.0-macabi",
        "CMAKE_CXX_COMPILER_TARGET": "arm64-apple-ios15.0-macabi",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "maccatalyst", "configurePreset": "maccatalyst", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "maccatalyst", "configurePreset": "maccatalyst", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
