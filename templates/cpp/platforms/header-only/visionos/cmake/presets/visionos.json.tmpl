{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "visionos",
      "displayName": "visionOS (device)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Xcode",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "visionOS",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "1.0",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED": "NO"
      }
    }
  ],
  "buildPresets": [
    { "name": "visionos", "configurePreset": "visionos", "configuration": "Debug" }
  ]
}
