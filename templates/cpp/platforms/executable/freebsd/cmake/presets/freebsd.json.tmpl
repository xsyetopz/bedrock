{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "freebsd",
      "displayName": "FreeBSD",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "FreeBSD" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "freebsd", "configurePreset": "freebsd", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "freebsd", "configurePreset": "freebsd", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
