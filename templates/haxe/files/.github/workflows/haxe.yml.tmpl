# Managed by bedrock.
name: Haxe

on:
  push:
    branches: [main, master]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  haxe:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: krdlab/setup-haxe@18e4b483cfffca2fb8881530bf8a6cec39dac8fb # v2.1.1
        with:
          haxe-version: 4.3.7
      - uses: taiki-e/install-action@ab49d3c64680143e184118bed66a46419fc15519 # v2.90.5
        with:
          tool: just@1.59.0
      - run: just haxe::setup
      # A repo whose checks need more on the runner, such as its own haxelib
      # libraries, adds those steps in this composite action; it runs after
      # just haxe::setup, so they land in .haxelib.
      - if: hashFiles('.github/actions/project-setup/action.yml') != ''
        uses: ./.github/actions/project-setup
      - run: just haxe::verify
