# Managed by bedrock. Formats, lints, type-checks, and tests the Haxe code. Put
# project recipes in project.just.

set shell := ["bash", "-euo", "pipefail", "-c"]
set working-directory := ".."

# hxcpp reads the macOS floor from the environment and defaults to 10.6 without it.
export MACOSX_DEPLOYMENT_TARGET := env("MACOSX_DEPLOYMENT_TARGET", "13.0")

# Start the local haxelib repo, .haxelib, and install the pinned checkstyle and
# formatter into it. A project-setup recipe in project.just runs after this one
# and installs the project's own libraries, such as with
# `haxelib install libraries.hxml --always`.
setup:
    if [[ ! -d .haxelib ]]; then haxelib newrepo; fi
    haxelib install checkstyle 2.9.0 --always
    haxelib install formatter 1.18.0 --always
    if [[ -f libraries.hxml ]]; then haxelib install libraries.hxml --always; fi

# Build a native binary into dist/<platform>/ through hxcpp: build-cpp.hxml names the program.
# hxcpp compiles for the OS it runs on, so the platform, one of linux, macos, or windows,
# has to be this machine's; it defaults to it. CI builds each platform on its own runner.
build platform="": hold
    #!/usr/bin/env bash
    set -euo pipefail
    case "$(uname -s)" in
        Darwin) host=macos ;;
        Linux) host=linux ;;
        MINGW* | MSYS* | CYGWIN*) host=windows ;;
        *) host=unknown ;;
    esac
    platform="{{ platform }}"
    platform="${platform:-$host}"
    case "$platform" in
        linux | macos | windows) ;;
        *) echo "unknown platform $platform; use linux, macos, or windows" >&2; exit 1 ;;
    esac
    if [[ "$platform" != "$host" ]]; then
        echo "hxcpp builds for the OS it runs on: build $platform on a $platform machine" >&2
        exit 1
    fi
    if [[ ! -f build-cpp.hxml ]]; then
        echo "build-cpp.hxml is missing: this repo has no native build" >&2
        exit 1
    fi
    ext=""
    if [[ "$platform" == windows ]]; then ext=.exe; fi
    name="$(sed -n 's/^-D HAXE_OUTPUT_FILE=//p' build-cpp.hxml)"
    rm -rf bin/cpp "dist/$platform"
    haxe build-cpp.hxml
    mkdir -p "dist/$platform"
    cp "bin/cpp/$name$ext" "dist/$platform/"

# Format the Haxe code.
format: hold
    {{ quote(replace(just_executable(), '\', '/')) }} bedrock haxe format

# Fail if the Haxe code is not formatted.
format-check: hold
    {{ quote(replace(just_executable(), '\', '/')) }} bedrock haxe format --check

# Compile each hxml file that names its target, without output.
typecheck: hold
    {{ quote(replace(just_executable(), '\', '/')) }} bedrock haxe typecheck

# Run checkstyle with checkstyle.json.
lint: hold
    {{ quote(replace(just_executable(), '\', '/')) }} bedrock haxe lint

# checkstyle fixes nothing, so this formats; `just lint` reports the rest.
lint-fix: hold
    {{ quote(replace(just_executable(), '\', '/')) }} bedrock haxe format

# Run each test hxml file that runs its tests.
test: hold
    {{ quote(replace(just_executable(), '\', '/')) }} bedrock haxe test

# Report what the Haxe linters cannot see.
guard:
    {{ quote(replace(just_executable(), '\', '/')) }} bedrock guard haxe

# Run every Haxe check CI runs.
verify: format-check typecheck lint guard test

# The Haxe checks the pre-commit hook runs.
pre-commit: format-check lint

# The Haxe checks the pre-push hook runs: verify without the tests, which CI runs.
pre-push: format-check typecheck lint guard

# Takes one of the machine's check slots for this run; see `hold-slot` in the justfile.
[private]
hold:
    @{{ quote(replace(just_executable(), '\', '/')) }} hold-slot "$PPID"
