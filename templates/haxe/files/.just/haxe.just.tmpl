# Managed by bedrock. Formats, lints, type-checks, and tests the Haxe code. Put
# project recipes in project.just.

set shell := ["bash", "-euo", "pipefail", "-c"]
set working-directory := ".."

# Start the local haxelib repo, .haxelib, and install the pinned checkstyle and
# formatter into it. A project-setup recipe in project.just runs after this one
# and installs the project's own libraries, such as with
# `haxelib install libraries.hxml --always`.
setup:
    if [[ ! -d .haxelib ]]; then haxelib newrepo; fi
    haxelib install checkstyle 2.9.0 --always
    haxelib install formatter 1.18.0 --always

# Format the Haxe code.
format:
    {{ just_executable() }} bedrock haxe format

# Fail if the Haxe code is not formatted.
format-check:
    {{ just_executable() }} bedrock haxe format --check

# Compile each hxml file that names its target, without output.
typecheck:
    {{ just_executable() }} bedrock haxe typecheck

# Run checkstyle with checkstyle.json.
lint:
    {{ just_executable() }} bedrock haxe lint

# checkstyle fixes nothing, so this formats; `just lint` reports the rest.
lint-fix:
    {{ just_executable() }} bedrock haxe format

# Run each test hxml file that runs its tests.
test:
    {{ just_executable() }} bedrock haxe test

# Report what the Haxe linters cannot see.
guard:
    {{ just_executable() }} bedrock guard haxe

# Run every Haxe check CI runs.
verify: format-check typecheck lint guard test

# The Haxe checks the pre-commit hook runs.
pre-commit: format-check lint

# The Haxe checks the pre-push hook runs: verify without the tests, which CI runs.
pre-push: format-check typecheck lint guard
