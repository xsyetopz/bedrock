<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>@@name@@</title>
  </head>
  <body>
    <p>@@name@@ writes to the browser console.</p>
    <script src="wasm_exec.js"></script>
    <script>
      const go = new Go();
      WebAssembly.instantiateStreaming(fetch("@@name@@.wasm"), go.importObject).then((result) =>
        go.run(result.instance),
      );
    </script>
  </body>
</html>
