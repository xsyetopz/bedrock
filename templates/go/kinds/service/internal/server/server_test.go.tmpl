package server_test

import (
	"io"
	"net/http"
	"net/http/httptest"
	"testing"

	"@@module@@/internal/server"
)

func TestHandlerGreetsByName(t *testing.T) {
	t.Parallel()

	srv := httptest.NewServer(server.Handler())
	t.Cleanup(srv.Close)

	req, err := http.NewRequestWithContext(t.Context(), http.MethodGet, srv.URL+"/hello/world", nil)
	if err != nil {
		t.Fatal(err)
	}

	resp, err := srv.Client().Do(req)
	if err != nil {
		t.Fatal(err)
	}

	defer func() { _ = resp.Body.Close() }()

	body, err := io.ReadAll(resp.Body)
	if err != nil {
		t.Fatal(err)
	}

	if resp.StatusCode != http.StatusOK || string(body) != "Hello, world!\n" {
		t.Errorf("GET /hello/world = %d %q, want 200 %q", resp.StatusCode, body, "Hello, world!\n")
	}
}

func TestHealthzReportsOK(t *testing.T) {
	t.Parallel()

	rec := httptest.NewRecorder()
	req := httptest.NewRequestWithContext(t.Context(), http.MethodGet, "/healthz", nil)

	server.Handler().ServeHTTP(rec, req)

	if rec.Code != http.StatusOK {
		t.Errorf("GET /healthz = %d, want %d", rec.Code, http.StatusOK)
	}
}
