+class ScalaStates(CodeStateMachine):  # pylint: disable=R0903
+    '''
+    A function ends where its body ends, not at the first line break: the body
+    runs while the lines that follow are indented deeper than the `def`, or
+    while its brackets are open. A `def` without a body is an abstract
+    declaration, which is not a function.
