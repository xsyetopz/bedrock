+        'type', 'given', 'extension', 'private', 'protected', 'override',
+        'final', 'implicit', 'abstract', 'sealed',
+    }
+    # A line that ends with one of these opens a block that goes on below.
+    _BLOCK_OPENS = {'=', '=>', ':', 'then', 'else', 'do', 'with', 'yield',
+                    'try', 'finally', 'match', '->', '<-'}
