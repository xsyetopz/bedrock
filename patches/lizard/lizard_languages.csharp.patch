+    def _in_member(self):
+        return bool(self._members) and \
+            self._members[-1][1] == self._open_braces
+
+    def _track_member(self, token):
+        """Keep the last name outside [...], the member a "{" opens."""
+        if token == '=' and self._square == 0:
+            self._assigned = True
+        if token in (';', '{', '}'):
+            self._assigned = False
+        if token == '[':
+            self._square += 1
+        elif token == ']':
+            self._square = max(self._square - 1, 0)
+        elif token in (';', '}', '=', '=>'):
+            self._member = None
+        elif self._square == 0 and (token[0].isalpha() or token[0] == '_'):
+            self._member = token
+
+    def _arrow(self):
+        """Read a "=>" the global state sees: after a member's name it opens
+        an expression-bodied property, a getter; after "=" it is a lambda
+        that initializes a field, whose body measures as no function."""
+        if self._member and not self._assigned:
+            name = f"{self._member}::get"
+            self.context.try_new_function(name)
+            if self.class_name:
+                self.context.current_function.name = \
+                    f"{self.class_name}::{name}"
+            self._enter_expression_body()
+        else:
+            self._state = self._state_initializer
+        self._member = None
+        self._assigned = False
+
+    def _state_initializer(self, token):
+        self._depth += {'(': 1, '[': 1, '{': 1, ')': -1, ']': -1, '}': -1}.get(token, 0)
+        if token == ';' and self._depth <= 0:
+            self._depth = 0
+            self._state = self._state_global
+
+    def _state_accessor(self, accessor, token):
+        """Measure an accessor body as a function named Member::accessor."""
+        if token not in ('{', '=>'):
+            self._state = self._state_global
+            self._state(token)
+            return
+        name = f"{self._members[-1][0] or ''}::{accessor}".lstrip(':')
+        self.context.try_new_function(name)
+        if self.class_name:
+            self.context.current_function.name = f"{self.class_name}::{name}"
+        if token == '=>':
+            self._enter_expression_body()
+        else:
+            self.next(self._state_entering_imp, token)
