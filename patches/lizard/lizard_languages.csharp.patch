Fixes to the C# reader of lizard 1.26.1.

- Verbatim (@"...") and raw ("""...""") strings: read as C strings, a
  backslash before their closing quote left them open, so the code after
  them turned into strings and one function swallowed the next.
- Property, indexer, and event accessors: their bodies have no parameter
  list, so lizard measured none of them and took `if (...) {` inside one for
  a function named `if`. Each accessor now measures as Member::get, and a
  statement keyword never names a function.
- Expression-bodied members: a member ending in `=> ...;` stayed the pending
  function, so the next "{" reopened it and lizard reported it twice with a
  wrong end line. A "=>" after a property's name measures as its getter, one
  that initializes a field measures as no function, and a body ends only at
  a ";" outside every bracket.

--- a/lizard_languages/csharp.py
+++ b/lizard_languages/csharp.py
@@ -5,6 +5,25 @@
 from .clike import CLikeReader, CLikeStates, CLikeNestingStackStates
 
 
+# A raw string, with its `$` prefixes, opens and closes with three or more
+# quotes and escapes nothing. A verbatim string, `@"..."`, `$@"..."` or
+# `@$"..."`, escapes a quote by doubling it, so a backslash before a quote
+# ends nothing. Read as C strings, `@"\"""` closes one quote late and turns
+# the code after it into strings.
+_RAW_STRING = r'|\$*"{3,}.*?"{3,}'
+_VERBATIM_STRING = r'|(?:\$@|@\$?)"(?:[^"]|"")*"'
+
+# Accessors are the bodies of properties, indexers and events. They have no
+# parameter list, so the C-like states never see them as functions.
+_ACCESSORS = {'get', 'set', 'init', 'add', 'remove'}
+
+# A statement keyword followed by `(...) {` has the shape of a method. Outside
+# a method body, as in a lambda that initializes a field, it is still a
+# statement and never names a function.
+_STATEMENTS = {'if', 'for', 'foreach', 'while', 'switch', 'catch', 'using',
+               'lock', 'fixed', 'return', 'when'}
+
+
 class CSharpReader(CLikeReader):
     # pylint: disable=R0903
 
