+    def _expect_function_impl(self, token):
+        """A `;` outside brackets ends a declaration without a body (trait
+        method, `extern` block): drop it instead of waiting for the `{` of
+        whatever comes next. `[u8; 4]` in the signature has its own `;`."""
+        if token in ('(', '['):
+            self._head_depth += 1
+        elif token in (')', ']'):
+            self._head_depth = max(0, self._head_depth - 1)
+        elif token == ';' and self._head_depth == 0:
+            context = self.context
+            listed = len(context.fileinfo.function_list)
+            context.end_of_function()
+            del context.fileinfo.function_list[listed:]
+            self._state = self._state_global
+            return
+        super()._expect_function_impl(token)
