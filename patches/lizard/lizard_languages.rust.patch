+    def _skip_macro_body(self, token):
+        if token in ('(', '[', '{'):
+            self._param_depth += 1
+        elif token in (')', ']', '}'):
+            self._param_depth -= 1
+            if self._param_depth == 0:
+                self._state = self._state_global
