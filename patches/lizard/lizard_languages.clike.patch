+# Tokenizer fragment for C++ raw strings R"delim(...)delim" (optional u8/u/U/L
+# prefix, delimiter of up to 16 characters, possibly empty). A string ends at the
+# first `)delim"`; read as ordinary strings, the quotes, braces and keywords
+# inside a custom delimiter's string became code. See #451, #478.
+_CPP_RAW_STRING_TOKEN = \
+    r"|(?:u8|u|U|L)?R\"(?P<rawdelim>[^\s()\\\"]{0,16})\(.*?\)(?P=rawdelim)\""
+# A C++ preprocessing number is one token: digit separators (1'000, 3.141'592,
+# 0XFF'FF, 1e1'0), exponents, suffixes. Split by the generic number rules, the
+# `'` after a fraction or an upper-case prefix opened a character literal that
+# swallowed the code up to the next `'`.
+_CPP_NUMBER_TOKEN = r"|(?:\.[0-9]|[0-9])(?:[eEpP][-+]|'[0-9A-Za-z_]|[0-9A-Za-z_.])*"
+# A character literal ends on its own line, so a lone `'`, as in the text of
+# `#error Don't` or `#pragma mark - It's`, pairs with no later `'`.
+_CPP_CHAR_TOKEN = r"|'(?:\\.|[^'\\\n])*'|'"
 
 
