+class CppNestingStackStates(CLikeNestingStackStates):
+    """The nesting machine for C, C++ and ObjC."""
+
+    def __init__(self, context):
+        super(CppNestingStackStates, self).__init__(context)
+        self._template_angles = 0
+        self._template_nested = 0
+
+    def _state_global(self, token):
+        if token == "template":
+            self._template_angles = 0
+            self._template_nested = 0
+            self._state = self._template_declaration
+        elif token == '}' and self._closes_function_try_block():
+            self._state = self._expect_catch
+        else:
+            super(CppNestingStackStates, self)._state_global(token)
+
+    def _template_declaration(self, token):
+        """Ignores template parameters.
+
+        A `<` or `>` counts only outside parentheses and brackets, so the
+        comparison in `template <bool B = (1 < 2)>` does not leave the angle
+        count open. An unparenthesised comparison (`<auto V = 1 < 2>`) cannot
+        be told from a bracket, so the header ends at a `{`, `}` or `;` too,
+        and that token is read as ordinary code.
+        """
+        if self._template_angles == 0 and token != '<':
+            # `template class Foo<int>;` has no parameter list.
+            self._end_template_header()
+            self._state(token)
+        elif token in ('(', '['):
+            self._template_nested += 1
+        elif token in (')', ']'):
+            self._template_nested = max(self._template_nested - 1, 0)
+        elif self._template_nested:
+            return
+        elif token == '<':
+            self._template_angles += 1
+        elif token == '>':
+            self._template_angles -= 1
+            if self._template_angles <= 0:
+                self._end_template_header()
+        elif token in ('{', '}', ';'):
+            self._end_template_header()
+            self._state(token)
+
+    def _end_template_header(self):
+        self._template_angles = 0
+        self._template_nested = 0
+        self._state = self._state_global
+
+    # A function-try-block, `int f() try { ... } catch (...) { ... }`, is one
+    # function: its `}` closes the function only after the last handler.
+    def _closes_function_try_block(self):
+        stack = self.context.nesting_stack
+        return bool(stack) and getattr(stack[-1], 'cpp_try', False)
+
+    def _expect_catch(self, token):
+        if token == 'catch':
+            self._state = self._catch_parameters
+        else:
+            self._end_try_block(token)
+
+    def _end_try_block(self, token=None):
+        # CppStates has popped the function already when a token follows, so
+        # that the next function's name is not qualified with this one.
+        if self._closes_function_try_block():
+            self.context.pop_nesting()
+        self._state = self._state_global
+        if token is not None:
+            self._state(token)
+
+    @CodeStateMachine.read_inside_brackets_then("()", "_catch_body")
+    def _catch_parameters(self, _):
+        pass
+
+    def _catch_body(self, token):
+        if token == '{':
+            self.next(self._catch_block, token)
+        else:
+            self._end_try_block(token)
+
+    @CodeStateMachine.read_inside_brackets_then("{}", "_expect_catch")
+    def _catch_block(self, _):
+        pass
+
+    def statemachine_before_return(self):
+        if self._state == self._expect_catch:
+            self._end_try_block()
