 import pygments.token as py_token
 from .pygments_fragments import join_fragments, lex_keeping_newlines
 
@@ -24,15 +26,41 @@
         return token
 
 
+# `$@"` and `@$"` strings are verbatim, but Pygments lexes them as escaped
+# ones, so a trailing `\"` swallows the rest of the file. Its `@"` lexing is
+# right; a space keeps every column and line.
+_VERBATIM_INTERPOLATED = re.compile(r'(?<![\w"@$])(?:\$@|@\$)"')
+
+
 def generate_tokens(source_code, is_comment):
     '''`is_comment(token)` tells comments, which start no line.'''
-    return _mark_line_starts(join_fragments(
+    source_code = _VERBATIM_INTERPOLATED.sub(' @"', source_code)
+    return _mark_line_starts(_join_primes(join_fragments(
         lex_keeping_newlines(source_code, 'fsharp'),
         joins=lambda _run, value: is_operator(value),
         comment_types=(py_token.String.Doc,),
-        keep_spaces=True), is_comment)
+        keep_spaces=True)), is_comment)
 
 
+def _join_primes(tokens):
+    '''Pygments leaves the `'` of `id' (x: 'T)` as a token of its own;
+    an identifier directly followed by one is a name with a prime.'''
+    held = None
+    for token in tokens:
+        if held is not None:
+            if token == "'":
+                held += token
+                continue
+            yield held
+            held = None
+        if re.match(r'\w+$', token):
+            held = token
+        else:
+            yield token
+    if held is not None:
+        yield held
+
+
