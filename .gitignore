# >>> bedrock
# Adapted from github/gitignore@41862c8 (CC0-1.0): Global/macOS, Global/VisualStudioCode,
# Global/JetBrains.
.env
.env.*
!.env.example
*.log
*.tmp
*.swp
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.apdisk

# Editors: shared settings stay tracked, personal state does not.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.vsix
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/**/aws.xml
.idea/**/dataSources/
.idea/**/dataSources.local.xml
.idea/httpRequests
*.iws
.zed/
# <<< bedrock

# >>> typescript-bedrock
# Adapted from github/gitignore@41862c8 (CC0-1.0): Node.
# No slash: a worktree may link its node_modules to the main checkout's.
node_modules
dist/
coverage/
.nyc_output/
*.lcov
*.tsbuildinfo
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.npm/
*.tgz
.node_repl_history
.tern-port
.vscode-test/
# <<< typescript-bedrock


# Editors index the Rust and Swift templates with rust-analyzer and SourceKit-LSP.
/target/
/.build/

# >>> go-bedrock
# Go build outputs, test binaries, and coverage profiles.
/bin/
*.exe
*.test
*.out
go.work.sum
# <<< go-bedrock
