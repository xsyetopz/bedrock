# >>> bedrock
# Adapted from github/gitignore@41862c8 (CC0-1.0): Global/macOS, Global/VisualStudioCode,
# Global/JetBrains.
.env
.env.*
!.env.example
*.bak
*.log
*.tmp
*.swp
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.apdisk

# Editors: shared settings stay tracked, personal state does not.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.vsix
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/**/aws.xml
.idea/**/dataSources/
.idea/**/dataSources.local.xml
.idea/httpRequests
*.iws
.zed/
# <<< bedrock

